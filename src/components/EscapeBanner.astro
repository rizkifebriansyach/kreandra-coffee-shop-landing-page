---
---

<section class="escape container" aria-labelledby="escape-title">
  <div class="escape__panel">
    <img
      class="escape__img"
      src="/images/interior.webp"
      alt="Café corner with wooden armchairs, monstera plants and a street-facing window"
      width="1200"
      height="1600"
      loading="lazy"
      decoding="async"
    />
    <div class="escape__body">
      <div class="escape__copy">
        <span class="escape__eyebrow">Relax. Sip. Enjoy.</span>
        <h2 id="escape-title" class="escape__title">Your Daily Escape</h2>
        <p class="escape__lead">Cozy vibes, great drinks,<br />better moments.</p>
        <div><a href="#locations" class="btn btn--light">Find a Café</a></div>
      </div>
      <div class="escape__art">
        <svg width="84" height="84" viewBox="0 0 64 64" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Iced coffee cup illustration"><path d="M18 20h28l-3 34H21z"/><path d="M16 14h32v6H16z"/><path d="M34 14 44 4"/><path d="M22 34c4-3 8-3 12 0s8 3 12 0"/><path d="M8 44c2-6 7-8 12-7-1 5-5 9-12 7z"/></svg>
      </div>
    </div>
  </div>
</section>

<style>
  .escape {
    padding-top: 16px;
    padding-bottom: 56px;
  }
  .escape__panel {
    display: flex;
    flex-wrap: wrap;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--green);
    color: var(--white);
  }
  .escape__img {
    flex: 1 1 380px;
    min-width: 0;
    width: 50%;
    min-height: 320px;
    max-height: 440px;
    object-fit: cover;
  }
  .escape__body {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    padding: 48px;
  }
  .escape__copy {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .escape__eyebrow {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: #d7dfd0;
  }
  .escape__title {
    font-size: clamp(36px, 4vw, 48px);
    color: var(--white);
  }
  .escape__lead {
    font-size: 15px;
    color: #e6ece0;
  }
  .escape__art {
    flex: 0 0 auto;
    width: 140px;
    height: 140px;
    border-radius: 20px;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 720px) {
    .escape__body {
      padding: 32px 24px;
    }
    .escape__art {
      display: none;
    }
  }
</style>
