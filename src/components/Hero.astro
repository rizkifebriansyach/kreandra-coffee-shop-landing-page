---
import Icon from './Icon.astro';

const features = [
  { icon: 'leaf', label: 'Premium Beans' },
  { icon: 'cup', label: 'Freshly Brewed' },
  { icon: 'heart', label: 'Made With Love' },
] as const;
---

<section id="top" class="hero container" aria-label="Hero">
  <div class="hero__copy">
    <h1 class="hero__title">
      <span>COFFEE.</span>
      <span>CALM.</span>
      <span class="hero__accent">
        GOOD VIBES.<svg class="hero__leaf" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7 2 3 6.5 3 12c0 3 1.5 5.5 3 7 1-4 3-7 6-9-2 3-3.5 6.5-4 10 1 .6 2.5 1 4 1 5 0 9-4.5 9-10 0-3-1-6-3-8-1 2-3 3-6 3 3-1 5-3 6-6-2-1-4-2-6-2z"/></svg>
      </span>
    </h1>
    <p class="hero__lead">Specialty beans. Real ingredients.<br />Brewed for your moment.</p>
    <div class="hero__cta">
      <a href="#menu" class="btn btn--primary">Order Now <Icon name="bag" size={14} /></a>
      <a href="#menu" class="btn btn--outline">View Menu <Icon name="cup" size={14} /></a>
    </div>
    <ul class="hero__features">
      {features.map((f) => (
        <li>
          <Icon name={f.icon} size={24} stroke="#3F5A3A" />
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="hero__media">
    <img
      src="/images/hero.webp"
      alt="A cappuccino and an iced matcha latte on a sunlit marble table"
      width="1200"
      height="1600"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__badge">100%<br />Arabica<br />Beans</div>
  </div>
</section>

<style>
  .hero {
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .hero__copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px 0 48px;
  }
  .hero__title {
    font-size: clamp(52px, 6vw, 84px);
    line-height: 0.98;
    letter-spacing: 0.02em;
  }
  .hero__title span {
    display: block;
  }
  .hero__accent {
    color: var(--green);
    white-space: nowrap;
  }
  .hero__leaf {
    display: inline-block;
    margin-left: 6px;
    vertical-align: 12px;
    transform: rotate(-20deg);
  }
  .hero__lead {
    max-width: 360px;
    font-size: 15px;
    color: var(--body);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero__features {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .hero__features li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 84px;
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--body);
  }
  .hero__media {
    flex: 1 1 480px;
    min-width: 0;
    position: relative;
  }
  .hero__media img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    object-position: center 60%;
    border-radius: var(--radius-lg);
  }
  .hero__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 96px;
    height: 96px;
    border-radius: 999px;
    background: var(--white);
    border: 1.5px solid var(--green);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--green);
    box-shadow: 0 8px 24px rgba(43, 47, 40, 0.12);
  }
  @media (max-width: 720px) {
    .hero__title {
      font-size: clamp(40px, 12vw, 52px);
    }
    .hero__leaf {
      width: 22px;
      height: 22px;
      vertical-align: 8px;
    }
    .hero__media img {
      height: 380px;
    }
    .hero__copy {
      padding-bottom: 16px;
    }
  }
</style>
