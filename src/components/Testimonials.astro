---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---

<section class="reviews container section" aria-labelledby="reviews-title">
  <div class="section-head section-head--center">
    <span class="eyebrow">Kind Words</span>
    <h2 id="reviews-title" class="h2">What regulars say</h2>
  </div>

  <div class="reviews__grid">
    {testimonials.map((t) => (
      <figure class="card review">
        <Icon name="quote" size={28} stroke="#9DAF93" />
        <blockquote class="review__quote">“{t.quote}”</blockquote>
        <figcaption class="review__by">
          <span class="review__avatar" style={`background:${t.tone}`} aria-hidden="true">{t.initials}</span>
          <span class="review__who">
            <span class="review__name">{t.name}</span>
            <span class="review__meta">{t.meta}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .reviews {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .review {
    margin: 0;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .review__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.4;
    font-style: italic;
  }
  .review__by {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  .review__avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    flex: 0 0 auto;
  }
  .review__who {
    display: flex;
    flex-direction: column;
  }
  .review__name {
    font-size: 14px;
    font-weight: 600;
  }
  .review__meta {
    font-size: 12px;
    color: var(--muted);
  }
</style>
