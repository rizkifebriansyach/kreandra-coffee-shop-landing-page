---
import Icon from './Icon.astro';
import { bestSellers } from '../data/site';
---

<section class="best container" aria-labelledby="bestsellers-title">
  <div class="best__head">
    <div class="section-head">
      <span class="eyebrow"><Icon name="leaf" size={14} /> Best Sellers</span>
      <h2 id="bestsellers-title" class="best__title">Your Favorites<br />Right Here</h2>
    </div>
    <a href="#menu" class="btn btn--outline">View All <Icon name="arrow" size={14} /></a>
  </div>

  <div class="best__grid">
    {bestSellers.map((p) => (
      <article class="card product">
        <div class="product__media">
          <img
            src={p.image}
            alt={p.alt}
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
            style={'position' in p ? `object-position: ${p.position}` : undefined}
          />
          {'badge' in p && (
            <span class:list={['product__badge', `product__badge--${p.badgeTone}`]}>{p.badge}</span>
          )}
        </div>
        <div class="product__body">
          <div>
            <h3 class="product__name">{p.name}</h3>
            <span class="product__price">{p.price}</span>
          </div>
          <button class="product__add" type="button" aria-label={`Add ${p.name} to order`}>
            <Icon name="plus" size={16} />
          </button>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .best {
    padding-top: 56px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .best__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .best__title {
    font-size: clamp(34px, 3.5vw, 44px);
  }
  .best__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .product {
    display: flex;
    flex-direction: column;
  }
  .product__media {
    position: relative;
    padding: 16px 16px 0;
  }
  .product__media img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .product__badge {
    position: absolute;
    top: 28px;
    right: 28px;
    padding: 6px 10px;
    border-radius: 999px;
    color: var(--white);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .product__badge--accent {
    background: var(--green);
  }
  .product__badge--ink {
    background: var(--ink);
  }
  .product__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
  }
  .product__body > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .product__name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .product__price {
    font-size: 13px;
    font-weight: 500;
    color: var(--green);
  }
  .product__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    background: var(--green);
    color: var(--white);
    cursor: pointer;
    flex: 0 0 auto;
  }
  .product__add:hover {
    background: var(--green-dark);
  }
</style>
