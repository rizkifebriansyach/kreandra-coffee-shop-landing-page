---
// Ikon stroke sederhana, satu komponen supaya konsisten di seluruh halaman.
interface Props {
  name:
    | 'bag'
    | 'cup'
    | 'leaf'
    | 'heart'
    | 'arrow'
    | 'plus'
    | 'menu'
    | 'pin'
    | 'clock'
    | 'glass'
    | 'bread'
    | 'download'
    | 'sprout'
    | 'gift'
    | 'instagram'
    | 'quote';
  size?: number;
  class?: string;
  stroke?: string;
}
const { name, size = 16, class: className, stroke = 'currentColor' } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke,
  'stroke-width': 1.8,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  class: className,
};
---

{name === 'bag' && <svg {...common}><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>}
{name === 'cup' && <svg {...common}><path d="M17 8h1a4 4 0 0 1 0 8h-1"/><path d="M3 8h14v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z"/><path d="M7 2v3M11 2v3"/></svg>}
{name === 'leaf' && <svg {...common}><path d="M12 3c3 2 5 5.5 5 9s-2 7-5 9c-3-2-5-5.5-5-9s2-7 5-9z"/><path d="M12 3c0 6-1 12 0 18"/></svg>}
{name === 'heart' && <svg {...common}><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>}
{name === 'arrow' && <svg {...common}><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
{name === 'plus' && <svg {...common} stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>}
{name === 'menu' && <svg {...common} stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>}
{name === 'pin' && <svg {...common}><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>}
{name === 'clock' && <svg {...common}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
{name === 'glass' && <svg {...common}><path d="M12 22c-4 0-7-3-7-8V4h14v10c0 5-3 8-7 8z"/><path d="M5 10h14"/><path d="M9 4l1-2h4l1 2"/></svg>}
{name === 'bread' && <svg {...common}><path d="M3 15c0-2 2-3 4-3h10c2 0 4 1 4 3v2H3v-2z"/><path d="M5 12V9c0-3 3-5 7-5s7 2 7 5v3"/><path d="M3 17v2h18v-2"/></svg>}
{name === 'download' && <svg {...common}><path d="M12 3v12M6 11l6 6 6-6"/><path d="M4 21h16"/></svg>}
{name === 'sprout' && <svg {...common}><path d="M4 20c2-8 8-13 16-14-1 8-6 14-14 14H4z"/><path d="M4 20c3-4 6-7 10-9"/></svg>}
{name === 'gift' && <svg {...common}><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 21V7"/><path d="M12 7c-2 0-4-1.5-4-3a2 2 0 0 1 4 0 2 2 0 0 1 4 0c0 1.5-2 3-4 3z"/></svg>}
{name === 'instagram' && <svg {...common}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill={stroke} stroke="none"/></svg>}
{name === 'quote' && <svg width={size} height={size} viewBox="0 0 24 24" fill={stroke} aria-hidden="true" class={className}><path d="M7 6C4.8 6 3 7.8 3 10v8h7v-7H6c0-1.7 1-2.5 2.5-2.5V6zm10 0c-2.2 0-4 1.8-4 4v8h7v-7h-4c0-1.7 1-2.5 2.5-2.5V6z"/></svg>}
