---
import Icon from './Icon.astro';
import { menu } from '../data/site';
---

<section id="menu" class="menu container section" aria-labelledby="menu-title">
  <div class="section-head section-head--center">
    <span class="eyebrow">The Menu</span>
    <h2 id="menu-title" class="h2">Something for every moment</h2>
    <p class="lead">Hot or iced, bold or gentle. Ask our baristas for today’s single-origin pour-over.</p>
  </div>

  <img
    class="menu__hero"
    src="/images/pastry.webp"
    alt="Croissants and a cinnamon-dusted cappuccino on a marble table, seen from above"
    width="1200"
    height="1600"
    loading="lazy"
    decoding="async"
  />

  <div class="menu__grid">
    {menu.map((group) => (
      <div class="card menu__card">
        <div class="menu__card-head">
          <Icon name={group.icon} size={22} stroke="#3F5A3A" />
          <h3 class="menu__category">{group.category}</h3>
        </div>
        <ul class="menu__list">
          {group.items.map((item) => (
            <li class="menu__row">
              <div>
                <span class="menu__item">{item.name}</span>
                <span class="menu__note">{item.note}</span>
              </div>
              <span class="menu__price">{item.price}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="menu__cta">
    <a href="#contact" class="btn btn--primary">Download Full Menu <Icon name="download" size={14} /></a>
  </div>
</section>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-bottom: 64px;
  }
  .menu__hero {
    width: 100%;
    height: 340px;
    object-fit: cover;
    object-position: center 45%;
    border-radius: var(--radius-lg);
  }
  .menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .menu__card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .menu__card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--green);
  }
  .menu__category {
    font-size: 28px;
    font-weight: 600;
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .menu__row:last-child {
    border-bottom: 0;
  }
  .menu__row > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .menu__item {
    font-size: 15px;
    font-weight: 500;
  }
  .menu__note {
    font-size: 12px;
    color: var(--muted);
  }
  .menu__price {
    font-size: 14px;
    font-weight: 500;
    color: var(--green);
    white-space: nowrap;
  }
  .menu__cta {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 720px) {
    .menu__hero {
      height: 240px;
    }
  }
</style>
