---
import { site } from '../data/site';

const pillars = [
  { title: 'Single Origin', text: 'Traceable beans from local farms' },
  { title: 'Small Batch', text: 'Roasted weekly for peak flavor' },
  { title: 'Brewed to Order', text: 'Every cup, every time' },
];
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container section about__inner">
    <div class="about__media">
      <img
        src="/images/barista.webp"
        alt="Barista pouring steamed milk into a latte to form a rosetta"
        width="1200"
        height="879"
        loading="lazy"
        decoding="async"
      />
      <img
        class="about__img--offset"
        src="/images/beans.webp"
        alt="Close-up of freshly roasted coffee beans"
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about__copy">
      <span class="eyebrow">Our Story</span>
      <h2 id="about-title" class="h2">Slow mornings,<br />honest beans.</h2>
      <p class="about__text">
        Kreandra is a neighborhood coffee house built around the small rituals of the day: the first pour, the quiet
        corner table, the conversation that runs a little longer than planned. We source single-origin beans from
        local farmers, roast in small batches, and brew every cup to order.
      </p>
      <p class="about__text">
        It started in {site.foundingYear} as a six-seat corner shop in Kemang, run by three friends who could not find a cup
        they loved within walking distance. Two cafés later, the rule is still the same: if we would not drink it
        ourselves, it does not go on the menu.
      </p>
      <ul class="about__pillars">
        {pillars.map((p) => (
          <li>
            <span class="about__pillar-title">{p.title}</span>
            <span class="about__pillar-text">{p.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--white);
  }
  .about__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }
  .about__media {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    gap: 16px;
  }
  .about__media img {
    flex: 1 1 0;
    width: 50%;
    min-width: 0;
    height: 440px;
    object-fit: cover;
    border-radius: 20px;
  }
  .about__img--offset {
    margin-top: 48px;
  }
  .about__copy {
    flex: 1 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about__text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--body);
  }
  .about__pillars {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 20px;
  }
  .about__pillars li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 16px;
    border-top: 1.5px solid var(--green);
  }
  .about__pillar-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
  }
  .about__pillar-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .about__media img {
      height: 300px;
    }
    .about__img--offset {
      margin-top: 32px;
    }
  }
</style>
